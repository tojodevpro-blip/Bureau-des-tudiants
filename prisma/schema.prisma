// Prisma schema - Plateforme BDE
// Base : PostgreSQL (Neon, Supabase ou PostgreSQL local)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  MEMBRE_BDE
  ADMIN
}

enum UserStatus {
  EN_ATTENTE
  APPROUVE
  REJETE
}

enum ElectionStatus {
  BROUILLON
  CANDIDATURES
  OUVERTE
  CLOTUREE
  PUBLIEE
}

enum CandidatureStatus {
  EN_ATTENTE
  VALIDEE
  REFUSEE
}

enum ReportTarget {
  ANNONCE
  COMMENTAIRE
  MESSAGE
  PHOTO
  DEMANDE
  EVENEMENT
}

enum ReportStatus {
  EN_ATTENTE
  TRAITEE
  REJETEE
}

enum AnnouncementStatus {
  BROUILLON
  PUBLIEE
  ARCHIVEE
}

enum RequestStatus {
  OUVERTE
  EN_COURS
  RESOLUE
  FERMEE
}

enum EventRsvpStatus {
  INSCRIT
  LISTE_ATTENTE
  ANNULE
}

enum TreasuryEntryType {
  RECETTE
  DEPENSE
}

enum TreasuryPaymentMethod {
  ESPECES
  MVOLA
  AIRTEL_MONEY
  VIREMENT
  AUTRE
}

enum ChannelType {
  GENERAL
  CLASSE
  ADMIN
  ANNONCES
}

enum PollStatus {
  BROUILLON
  OUVERT
  CLOTURE
}

enum PollResultsMode {
  IMMEDIAT
  APRES_CLOTURE
}

enum CommentTarget {
  ANNONCE
  EVENEMENT
}

model Student {
  id               String   @id @default(cuid())
  matricule        String   @unique
  matriculeBrut    String?  @map("matricule_brut")
  nom              String
  prenoms          String
  classe           String
  noteVerification String?  @map("note_verification")
  actif            Boolean  @default(true)
  claimedByUserId  String?  @unique @map("claimed_by_user_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  claimedBy          User?                  @relation("ClaimedStudent", fields: [claimedByUserId], references: [id], onDelete: SetNull)
  user               User?                  @relation("StudentAccount")
  candidates         Candidate[]
  applications       CandidateApplication[]
  supportRequests    SupportRequest[]       @relation("SupportRequestStudent")
  pollParticipations PollParticipation[]
  photoTags          PhotoTag[]

  @@index([classe])
  @@index([actif])
  @@index([nom])
  @@map("students")
}

model User {
  id                 String     @id @default(cuid())
  studentId          String?    @unique @map("student_id")
  email              String?    @unique
  telephone          String?    @unique
  motDePasseHash     String     @map("mot_de_passe_hash")
  role               Role       @default(STUDENT)
  statut             UserStatus @default(APPROUVE)
  tresorerieAccess   Boolean    @default(false) @map("tresorerie_access")
  photoUrl           String?    @map("photo_url")
  notificationsEmail Boolean    @default(true) @map("notifications_email")
  consentementPhotos Boolean    @default(false) @map("consentement_photos")
  sessionVersion     Int        @default(0) @map("session_version")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  lastLogin          DateTime?  @map("last_login")

  student            Student?               @relation("StudentAccount", fields: [studentId], references: [id], onDelete: Cascade)
  claimedStudent     Student?               @relation("ClaimedStudent")
  participations     VoteParticipation[]
  notifications      Notification[]
  passwordResets     PasswordResetToken[]
  reportsMade        Report[]               @relation("ReportReporter")
  reportsHandled     Report[]               @relation("ReportHandler")
  announcements      Announcement[]         @relation("AnnouncementAuthor")
  announcementReads  AnnouncementRead[]
  announcementEdits  AnnouncementRevision[]
  applications       CandidateApplication[]
  supportRequests    SupportRequest[]       @relation("SupportRequestUser")
  supportAssigned    SupportRequest[]       @relation("SupportAssignee")
  supportReplies     SupportReply[]
  responseTemplates  ResponseTemplate[]
  eventsCreated      Event[]                @relation("EventAuthor")
  eventRsvps         EventRsvp[]
  albumsCreated      Album[]                @relation("AlbumAuthor")
  mediaUploaded      AlbumMedia[]           @relation("MediaAuthor")
  mediaHidden        AlbumMedia[]           @relation("MediaHider")
  photoTags          PhotoTag[]
  documents          Document[]             @relation("DocumentAuthor")
  channelsCreated    Channel[]              @relation("ChannelAuthor")
  messages           Message[]
  messageReactions   MessageReaction[]
  channelReads       ChannelRead[]
  mutesReceived      Mute[]                 @relation("MuteTarget")
  mutesCreated       Mute[]                 @relation("MuteAuthor")
  comments           Comment[]
  pollsCreated       Poll[]                 @relation("PollAuthor")
  pollParticipations PollParticipation[]
  treasuryEntries    TreasuryEntry[]        @relation("TreasuryAuthor")
  auditLogs          AuditLog[]

  @@index([role])
  @@index([statut])
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Notification {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  type        String
  titre       String
  message     String
  url         String?
  dedupeKey   String?   @unique @map("dedupe_key")
  readAt      DateTime? @map("read_at")
  emailSentAt DateTime? @map("email_sent_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([createdAt])
  @@map("notifications")
}

model Report {
  id          String       @id @default(cuid())
  targetType  ReportTarget @map("target_type")
  targetId    String       @map("target_id")
  motif       String
  details     String?
  statut      ReportStatus @default(EN_ATTENTE)
  reporterId  String?      @map("reporter_id")
  handledById String?      @map("handled_by_id")
  resolution  String?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  reporter  User? @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  handledBy User? @relation("ReportHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([statut, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

model AuditLog {
  id        String   @id @default(cuid())
  acteur    String
  action    String
  details   Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([createdAt])
  @@index([userId])
  @@map("audit_logs")
}

model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime @map("reset_at")

  @@index([resetAt])
  @@map("rate_limits")
}

model Setting {
  key       String   @id
  valeur    String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model Election {
  id          String         @id @default(cuid())
  titre       String
  description String?
  statut      ElectionStatus @default(BROUILLON)
  ouvreLe     DateTime?      @map("ouvre_le")
  fermeLe     DateTime?      @map("ferme_le")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  positions      ElectionPosition[]
  candidates     Candidate[]
  applications   CandidateApplication[]
  participations VoteParticipation[]
  ballots        Ballot[]

  @@index([statut])
  @@index([fermeLe])
  @@map("elections")
}

model ElectionPosition {
  id          String   @id @default(cuid())
  electionId  String   @map("election_id")
  titre       String
  description String?
  ordre       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  election     Election               @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidates   Candidate[]
  applications CandidateApplication[]
  ballots      Ballot[]

  @@unique([electionId, titre])
  @@index([electionId, ordre])
  @@map("election_positions")
}

model Candidate {
  id         String   @id @default(cuid())
  electionId String   @map("election_id")
  positionId String?  @map("position_id")
  studentId  String?  @map("student_id")
  nomAffiche String   @map("nom_affiche")
  photoUrl   String?  @map("photo_url")
  slogan     String?
  programme  String?
  videoUrl   String?  @map("video_url")
  ordre      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  election Election          @relation(fields: [electionId], references: [id], onDelete: Cascade)
  position ElectionPosition? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  student  Student?          @relation(fields: [studentId], references: [id], onDelete: SetNull)
  ballots  Ballot[]

  @@unique([electionId, positionId, studentId])
  @@index([electionId, positionId, ordre])
  @@map("candidates")
}

model CandidateApplication {
  id           String            @id @default(cuid())
  electionId   String            @map("election_id")
  positionId   String            @map("position_id")
  studentId    String            @map("student_id")
  photoUrl     String?           @map("photo_url")
  slogan       String?
  programme    String?
  videoUrl     String?           @map("video_url")
  statut       CandidatureStatus @default(EN_ATTENTE)
  motif        String?
  reviewedById String?           @map("reviewed_by_id")
  reviewedAt   DateTime?         @map("reviewed_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  election Election         @relation(fields: [electionId], references: [id], onDelete: Cascade)
  position ElectionPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  student  Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reviewer User?            @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([electionId, positionId, studentId])
  @@index([electionId, statut])
  @@index([studentId])
  @@map("candidate_applications")
}

model VoteParticipation {
  id         String   @id @default(cuid())
  electionId String   @map("election_id")
  userId     String   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([electionId, userId])
  @@index([electionId])
  @@map("vote_participations")
}

// Aucune reference a l'utilisateur et aucun horodatage precis : le scrutin reste secret.
model Ballot {
  id          String   @id @default(cuid())
  electionId  String   @map("election_id")
  positionId  String?  @map("position_id")
  candidateId String?  @map("candidate_id")
  dateVote    DateTime @map("date_vote") @db.Date

  election  Election          @relation(fields: [electionId], references: [id], onDelete: Cascade)
  position  ElectionPosition? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  candidate Candidate?        @relation(fields: [candidateId], references: [id], onDelete: Restrict)

  @@index([electionId])
  @@index([electionId, positionId])
  @@index([candidateId])
  @@map("ballots")
}

model Announcement {
  id          String             @id @default(cuid())
  titre       String
  contenu     String
  categorie   String
  imageUrl    String?            @map("image_url")
  cibleToutes Boolean            @default(true) @map("cible_toutes")
  classes     String[]
  epingle     Boolean            @default(false)
  urgent      Boolean            @default(false)
  statut      AnnouncementStatus @default(BROUILLON)
  publieLe    DateTime?          @map("publie_le")
  expireLe    DateTime?          @map("expire_le")
  archivedAt  DateTime?          @map("archived_at")
  createdById String             @map("created_by_id")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  createdBy User                   @relation("AnnouncementAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  reads     AnnouncementRead[]
  revisions AnnouncementRevision[]
  comments  Comment[]

  @@index([statut, publieLe])
  @@index([categorie])
  @@index([createdById])
  @@map("announcements")
}

model AnnouncementRead {
  id             String   @id @default(cuid())
  announcementId String   @map("announcement_id")
  userId         String   @map("user_id")
  readAt         DateTime @default(now()) @map("read_at")

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId, readAt])
  @@map("announcement_reads")
}

model AnnouncementRevision {
  id             String   @id @default(cuid())
  announcementId String   @map("announcement_id")
  titre          String
  contenu        String
  modifiedById   String   @map("modified_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  modifiedBy   User         @relation(fields: [modifiedById], references: [id], onDelete: Restrict)

  @@index([announcementId, createdAt])
  @@map("announcement_revisions")
}

model SupportRequest {
  id            String        @id @default(cuid())
  numero        Int           @unique @default(autoincrement())
  userId        String        @map("user_id")
  studentId     String?       @map("student_id")
  anonyme       Boolean       @default(false)
  categorie     String
  sujet         String
  message       String
  attachmentKey String?       @map("attachment_key")
  statut        RequestStatus @default(OUVERTE)
  assignedToId  String?       @map("assigned_to_id")
  faqPubliee    Boolean       @default(false) @map("faq_publiee")
  closedAt      DateTime?     @map("closed_at")
  reopenUntil   DateTime?     @map("reopen_until")
  lastReplyAt   DateTime?     @map("last_reply_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user       User           @relation("SupportRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  student    Student?       @relation("SupportRequestStudent", fields: [studentId], references: [id], onDelete: SetNull)
  assignedTo User?          @relation("SupportAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  replies    SupportReply[]
  comments   Comment[]

  @@index([statut, createdAt])
  @@index([assignedToId])
  @@index([userId])
  @@map("support_requests")
}

model SupportReply {
  id            String   @id @default(cuid())
  requestId     String   @map("request_id")
  authorId      String   @map("author_id")
  contenu       String
  interne       Boolean  @default(false)
  attachmentKey String?  @map("attachment_key")
  createdAt     DateTime @default(now()) @map("created_at")

  request SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User           @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@map("support_replies")
}

model ResponseTemplate {
  id          String   @id @default(cuid())
  titre       String
  contenu     String
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@map("response_templates")
}

model Event {
  id            String    @id @default(cuid())
  titre         String
  description   String
  lieu          String
  debut         DateTime
  fin           DateTime
  visuelUrl     String?   @map("visuel_url")
  categorie     String
  capacite      Int?
  prixModalites String?   @map("prix_modalites")
  annuleLe      DateTime? @map("annule_le")
  createdById   String    @map("created_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  createdBy       User            @relation("EventAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  rsvps           EventRsvp[]
  treasuryEntries TreasuryEntry[]

  @@index([debut])
  @@index([categorie])
  @@map("events")
}

model EventRsvp {
  id          String          @id @default(cuid())
  eventId     String          @map("event_id")
  userId      String          @map("user_id")
  statut      EventRsvpStatus @default(INSCRIT)
  qrToken     String          @unique @map("qr_token")
  checkedInAt DateTime?       @map("checked_in_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, statut])
  @@map("event_rsvps")
}

model TreasuryEntry {
  id            String                @id @default(cuid())
  type          TreasuryEntryType
  libelle       String
  categorie     String
  montant       Int
  date          DateTime
  moyenPaiement TreasuryPaymentMethod @map("moyen_paiement")
  reference     String?
  payeur        String?
  note          String?
  eventId       String?               @map("event_id")
  createdById   String                @map("created_by_id")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  createdBy User   @relation("TreasuryAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  event     Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([type, date])
  @@index([categorie])
  @@index([eventId])
  @@map("treasury_entries")
}

model Album {
  id          String   @id @default(cuid())
  titre       String
  description String?
  annee       Int
  eventId     String?  @map("event_id")
  coverKey    String?  @map("cover_key")
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  createdBy User         @relation("AlbumAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  media     AlbumMedia[]

  @@index([annee])
  @@index([eventId])
  @@map("albums")
}

model AlbumMedia {
  id           String   @id @default(cuid())
  albumId      String   @map("album_id")
  storageKey   String   @map("storage_key")
  thumbKey     String?  @map("thumb_key")
  nom          String
  typeMime     String   @map("type_mime")
  taille       Int
  largeur      Int?
  hauteur      Int?
  masque       Boolean  @default(false)
  masqueParId  String?  @map("masque_par_id")
  motifMasque  String?  @map("motif_masque")
  uploadedById String   @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  album      Album      @relation(fields: [albumId], references: [id], onDelete: Cascade)
  uploadedBy User       @relation("MediaAuthor", fields: [uploadedById], references: [id], onDelete: Restrict)
  masquePar  User?      @relation("MediaHider", fields: [masqueParId], references: [id], onDelete: SetNull)
  tags       PhotoTag[]

  @@index([albumId, createdAt])
  @@map("album_media")
}

model PhotoTag {
  id        String   @id @default(cuid())
  mediaId   String   @map("media_id")
  userId    String   @map("user_id")
  studentId String?  @map("student_id")
  createdAt DateTime @default(now()) @map("created_at")

  media   AlbumMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  student Student?   @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@unique([mediaId, userId])
  @@index([userId])
  @@map("photo_tags")
}

model Document {
  id           String   @id @default(cuid())
  titre        String
  description  String?
  categorie    String
  storageKey   String   @map("storage_key")
  nom          String
  typeMime     String   @map("type_mime")
  taille       Int
  dateDocument DateTime @map("date_document")
  createdById  String   @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  createdBy User @relation("DocumentAuthor", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([categorie, dateDocument])
  @@map("documents")
}

model Channel {
  id          String      @id @default(cuid())
  nom         String
  slug        String      @unique
  type        ChannelType @default(GENERAL)
  classe      String?
  readOnly    Boolean     @default(false) @map("read_only")
  createdById String?     @map("created_by_id")
  createdAt   DateTime    @default(now()) @map("created_at")

  createdBy User?         @relation("ChannelAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  messages  Message[]
  reads     ChannelRead[]

  @@index([type])
  @@map("channels")
}

model Message {
  id          String    @id @default(cuid())
  channelId   String    @map("channel_id")
  authorId    String    @map("author_id")
  contenu     String?
  imageKey    String?   @map("image_key")
  replyToId   String?   @map("reply_to_id")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  channel   Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author    User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replyTo   Message?          @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[]         @relation("MessageReply")
  reactions MessageReaction[]

  @@index([channelId, createdAt])
  @@index([authorId])
  @@map("messages")
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

model ChannelRead {
  id         String   @id @default(cuid())
  channelId  String   @map("channel_id")
  userId     String   @map("user_id")
  lastReadAt DateTime @default(now()) @map("last_read_at")

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@map("channel_reads")
}

model Mute {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  until       DateTime?
  motif       String
  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  user      User @relation("MuteTarget", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User @relation("MuteAuthor", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([userId, until])
  @@map("mutes")
}

model Comment {
  id          String        @id @default(cuid())
  targetType  CommentTarget @map("target_type")
  targetId    String        @map("target_id")
  authorId    String        @map("author_id")
  contenu     String
  deletedAt   DateTime?     @map("deleted_at")
  deletedById String?       @map("deleted_by_id")
  createdAt   DateTime      @default(now()) @map("created_at")

  author           User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  announcement     Announcement?   @relation(fields: [announcementId], references: [id])
  announcementId   String?
  supportRequest   SupportRequest? @relation(fields: [supportRequestId], references: [id])
  supportRequestId String?

  @@index([targetType, targetId, createdAt])
  @@map("comments")
}

model Poll {
  id             String          @id @default(cuid())
  question       String
  description    String?
  multiple       Boolean         @default(false)
  anonyme        Boolean         @default(false)
  resultatsMode  PollResultsMode @default(APRES_CLOTURE) @map("resultats_mode")
  closesAt       DateTime?       @map("closes_at")
  audienceToutes Boolean         @default(true) @map("audience_toutes")
  classes        String[]
  statut         PollStatus      @default(BROUILLON)
  createdById    String          @map("created_by_id")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  createdBy      User                @relation("PollAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  options        PollOption[]
  participations PollParticipation[]
  pollBallots    PollBallot[]

  @@index([statut, closesAt])
  @@map("polls")
}

model PollOption {
  id     String @id @default(cuid())
  pollId String @map("poll_id")
  label  String
  ordre  Int    @default(0)

  poll    Poll         @relation(fields: [pollId], references: [id], onDelete: Cascade)
  ballots PollBallot[]

  @@index([pollId, ordre])
  @@map("poll_options")
}

model PollParticipation {
  id        String   @id @default(cuid())
  pollId    String   @map("poll_id")
  userId    String   @map("user_id")
  studentId String?  @map("student_id")
  createdAt DateTime @default(now()) @map("created_at")

  poll    Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@unique([pollId, userId])
  @@index([pollId])
  @@map("poll_participations")
}

// Aucun lien vers le votant : le choix reste separe de la participation.
model PollBallot {
  id       String @id @default(cuid())
  pollId   String @map("poll_id")
  optionId String @map("option_id")

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@index([pollId, optionId])
  @@map("poll_ballots")
}
