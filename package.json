{
  "name": "plateforme-bde",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Plateforme communautaire du Bureau des Étudiants : annonces, événements, archives, demandes, communication, trésorerie et module électoral optionnel",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "local:start": "tsx scripts/local-start.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:dev": "tsx scripts/dev-db.ts",
    "seed:students": "tsx scripts/seed-students.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "loadtest": "tsx scripts/load-test.ts",
    "docs:tech": "node scripts/generate-tech-sheet.mjs"
  },
  "prisma": {
    "seed": "tsx scripts/seed-students.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "@aws-sdk/s3-request-presigner": "^3.1166.0",
    "@fontsource-variable/inter": "5.2.8",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "csv-parse": "^7.0.3",
    "date-fns": "4.1.0",
    "exceljs": "4.4.0",
    "file-type": "^22.3.0",
    "jose": "6.2.17",
    "jsqr": "^1.4.0",
    "lucide-react": "0.468.0",
    "marked": "^18.2.0",
    "next": "15.5.29",
    "pdf-lib": "1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "2.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "@types/sanitize-html": "^2.16.2",
    "autoprefixer": "10.4.20",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.29",
    "postcss": "8.4.49",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
