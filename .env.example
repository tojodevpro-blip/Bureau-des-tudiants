# ============================================================
# Base de données PostgreSQL
# ============================================================
# Production : Neon, Supabase ou PostgreSQL managé.
# Format : postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:5432/BASE?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/bde?schema=public"

# ============================================================
# Authentification
# ============================================================
# Secret de signature des sessions. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Minimum 32 caractères. Ne jamais réutiliser entre environnements.
AUTH_SECRET="remplacer-par-un-secret-aleatoire-de-32-caracteres-minimum"

# ============================================================
# Compte administrateur (créé uniquement par script)
# ============================================================
ADMIN_EMAIL="admin@bde.local"
ADMIN_PASSWORD="remplacer-par-un-mot-de-passe-fort-et-unique"
ADMIN_NOM="Administrateur BDE"

# ============================================================
# Application
# ============================================================
# URL publique HTTPS en production (active aussi les cookies sécurisés).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================================
# Stockage des fichiers (optionnel)
# ============================================================
# Sans ces variables, les fichiers sont stockés dans .data/uploads.
# Sur un hébergement sans disque persistant, configure un bucket S3 compatible.
# S3_BUCKET="bde-uploads"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_REGION="auto"
# S3_ENDPOINT="https://..."
# S3_FORCE_PATH_STYLE="true"

# Secret dédié aux liens signés des fichiers (facultatif, AUTH_SECRET sinon).
# FILE_SIGNING_SECRET=""

# ============================================================
# Emails transactionnels (optionnel)
# ============================================================
# Sans ces variables, les notifications restent visibles dans l'application.
# RESEND_API_KEY="re_..."
# MAIL_FROM="BDE <notifications@bde.mg>"
